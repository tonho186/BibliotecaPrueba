@using SOL_ANTONIO_MIRANDA.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model SOL_ANTONIO_MIRANDA.Models.Prestamo

@{
    var usuariosSancionados = ViewBag.UsuariosSancionados as List<Usuario>;
    var mensaje = usuariosSancionados?.Count > 0
        ? "Algunos usuarios están sancionados y no pueden realizar préstamos."
        : null;
}
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var tieneDeuda = @((ViewBag.TieneDeuda ?? false).ToString().ToLower());
            if (tieneDeuda) {
                var deudaModal = new bootstrap.Modal(document.getElementById('deudaModal'));
                deudaModal.show();

                // Opcional: deshabilitar el formulario para evitar que el usuario intente enviar
                var form = document.querySelector('form');
                if (form) {
                    form.querySelectorAll('input, button, select, textarea').forEach(elem => {
                        elem.disabled = true;
                    });
                }
            }
        });
    </script>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-warning">@mensaje</div>
}

<h2>Registrar Préstamo</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Create" method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.Usuarios">
            <option value="">-- Seleccione --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Libro</label>
        <select asp-for="ISBN" class="form-select" asp-items="ViewBag.Libros">
            <option value="">-- Seleccione --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Tipo de Lectura</label>
        <select asp-for="TipoLectura" class="form-select">
            <option value="Sala">Sala</option>
            <option value="Casa">Casa</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Registrar Préstamo</button>
</form>

<div class="modal fade" id="deudaModal" tabindex="-1" aria-labelledby="deudaModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="deudaModalLabel">Préstamo bloqueado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ⚠️ No puedes realizar nuevos préstamos porque tienes libros sin devolver.
                Por favor, devuelve los libros pendientes para poder seguir usando el servicio.
            </div>
            <div class="modal-footer">
                <a asp-controller="Usuarios" asp-action="Perfil" class="btn btn-primary">Ver mi perfil</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>